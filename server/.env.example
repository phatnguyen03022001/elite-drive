NODE_ENV=development
APP_PORT=8000

# Browser origins allowed by the NestJS API.
FRONTEND_URL=http://localhost:3000
ALLOW_VERCEL_PREVIEWS=false

# Database
# Matches docker/mongodb/docker-compose.yml and supports Prisma transactions.
DATABASE_URL=mongodb://localhost:27017/elitedrive?replicaSet=rs0&directConnection=true

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
OTP_HASH_SECRET=replace-with-a-separate-long-random-secret
BCRYPT_ROUNDS=10

# System accounts
# Matches the deterministic local admin account created by prisma/seed.ts.
PLATFORM_USER_ID=000000000000000000000001

# Development-only mock payment flow. The application also checks NODE_ENV != production.
MOCK_PAYMENTS_ENABLED=false

# Optional MoMo sandbox adapter. Disabled by default.
# The application does not require a payment provider to run locally.
MOMO_ENABLED=false
MOMO_BASE_URL=https://test-payment.momo.vn
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_PARTNER_NAME=Elite Drive
MOMO_STORE_ID=EliteDrive
MOMO_REDIRECT_URL=http://localhost:3000/customer/payment-result
MOMO_IPN_URL=

# Local portfolio seed data
SEED_PASSWORD=LocalSeed!2026

# Uploads are stored on the local filesystem by default.
UPLOAD_DIR=uploads
UPLOAD_PUBLIC_BASE_URL=/api/upload/files

# Email OTP delivery uses the local application log.
# No external email account or API key is required.
