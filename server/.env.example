NODE_ENV=development
APP_PORT=8000

# Browser origins allowed by the NestJS API.
FRONTEND_URL=http://localhost:3000
ALLOW_VERCEL_PREVIEWS=false

# Database
DATABASE_URL=mongodb://localhost:27017/elitedrive

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
OTP_HASH_SECRET=replace-with-a-separate-long-random-secret
BCRYPT_ROUNDS=10

# System accounts
PLATFORM_USER_ID=replace-with-platform-user-object-id

# Development-only mock payment flow. The application also checks NODE_ENV != production.
MOCK_PAYMENTS_ENABLED=false

# MoMo payment gateway. Keep disabled until sandbox credentials are configured.
MOMO_ENABLED=false
MOMO_BASE_URL=https://test-payment.momo.vn
MOMO_PARTNER_CODE=replace-with-momo-sandbox-partner-code
MOMO_ACCESS_KEY=replace-with-momo-sandbox-access-key
MOMO_SECRET_KEY=replace-with-momo-sandbox-secret-key
MOMO_PARTNER_NAME=Elite Drive
MOMO_STORE_ID=EliteDrive
MOMO_REDIRECT_URL=http://localhost:3000/customer/payment-result
MOMO_IPN_URL=https://your-public-api.example.com/api/payments/momo/ipn

# Local portfolio seed data
SEED_PASSWORD=LocalSeed!2026

# Transactional email
BREVO_API_KEY=replace-with-your-provider-key
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=Elite Drive
