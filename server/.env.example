NODE_ENV=development
APP_PORT=8000

# Browser origins allowed by the NestJS API.
FRONTEND_URL=http://localhost:3000
ALLOW_VERCEL_PREVIEWS=false

# Database
DATABASE_URL=mongodb://localhost:27017/elitedrive

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
OTP_HASH_SECRET=replace-with-a-separate-long-random-secret
BCRYPT_ROUNDS=10

# System accounts
PLATFORM_USER_ID=replace-with-platform-user-object-id

# Local portfolio seed data
SEED_PASSWORD=LocalSeed!2026

# Transactional email
BREVO_API_KEY=replace-with-your-provider-key
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=Elite Drive
