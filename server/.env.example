# Elite Drive backend environment
# Copy this file to .env for local development. Never commit real secrets.

# -----------------------------------------------------------------------------
# Runtime / application
# -----------------------------------------------------------------------------

# OPTIONAL. production | development | test. Defaults to development behavior.
NODE_ENV=development

# OPTIONAL / PLATFORM-MANAGED. Cloud Run injects PORT automatically; normally leave it unset.
# PORT=8000

# OPTIONAL locally. Fallback when PORT is not provided.
APP_PORT=8000

# OPTIONAL legacy/compatibility settings.
APP_NAME=Elite Drive API
API_PREFIX=api

# REQUIRED IN PRODUCTION. Browser origin allowed by the NestJS API.
# Production: https://elite-drive-iota.vercel.app
FRONTEND_URL=http://localhost:3000

# OPTIONAL. Allow trusted *.vercel.app preview origins only when intentionally enabled.
ALLOW_VERCEL_PREVIEWS=false

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# REQUIRED.
# Local replica-set example matches docker/mongodb/docker-compose.yml and Prisma transactions.
DATABASE_URL=mongodb://localhost:27017/elitedrive?replicaSet=rs0&directConnection=true
# MongoDB Atlas connection-string guide:
# https://www.mongodb.com/docs/atlas/connect-your-application/

# -----------------------------------------------------------------------------
# Authentication / security
# -----------------------------------------------------------------------------

# REQUIRED. Use separate random secrets. Example generator: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
OTP_HASH_SECRET=replace-with-a-separate-long-random-secret

# OPTIONAL legacy/compatibility settings. Current auth module signs access JWTs for 7d.
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# OPTIONAL. Integer 4..31; 10 is the project default/baseline.
BCRYPT_ROUNDS=10

# REQUIRED IN PRODUCTION. Must be the ObjectId of the platform/system account used by payments.
# Local seed default only:
PLATFORM_USER_ID=000000000000000000000001

# OPTIONAL. Development-only mock payment flow; production code also checks NODE_ENV.
MOCK_PAYMENTS_ENABLED=false

# -----------------------------------------------------------------------------
# Cloudinary image uploads
# -----------------------------------------------------------------------------

# OPTIONAL FOR LOCAL DEVELOPMENT; REQUIRED=true IN PRODUCTION.
# false uses the ephemeral local filesystem fallback and is not a production durability mode.
CLOUDINARY_ENABLED=false

# REQUIRED WHEN CLOUDINARY_ENABLED=true, including all production deployments.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Get Cloud Name / API Key / API Secret:
# https://cloudinary.com/documentation/developer_onboarding_faq_find_credentials
# Node SDK configuration reference:
# https://cloudinary.com/documentation/node_integration#configure

# -----------------------------------------------------------------------------
# Brevo transactional OTP email
# -----------------------------------------------------------------------------

# OPTIONAL. false logs OTP locally only in non-production; production OTP delivery is unavailable.
BREVO_ENABLED=false

# REQUIRED WHEN BREVO_ENABLED=true. BREVO_SENDER_EMAIL must be a registered/verified sender.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# OPTIONAL. Defaults to Elite Drive.
BREVO_SENDER_NAME=Elite Drive

# API key + transactional email guide:
# https://developers.brevo.com/docs/send-a-transactional-email
# Sender/domain setup and verification:
# https://developers.brevo.com/docs/getting-started-with-senders-and-domains
# Brevo API keys dashboard:
# https://app.brevo.com/settings/keys/api

# -----------------------------------------------------------------------------
# MoMo payment gateway
# -----------------------------------------------------------------------------

# OPTIONAL. false disables external MoMo checkout.
MOMO_ENABLED=false

# OPTIONAL. Sandbox default. Production domain is https://payment.momo.vn
MOMO_BASE_URL=https://test-payment.momo.vn

# REQUIRED WHEN MOMO_ENABLED=true.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
# Production redirect: https://elite-drive-iota.vercel.app/customer/payment-result
MOMO_REDIRECT_URL=http://localhost:3000/customer/payment-result
# Production IPN: https://elite-drive-api-eq4iwb3wxa-as.a.run.app/api/payments/momo/ipn
MOMO_IPN_URL=

# OPTIONAL display metadata.
MOMO_PARTNER_NAME=Elite Drive
MOMO_STORE_ID=EliteDrive

# Get Partner Code / Access Key / Secret Key and integration instructions:
# https://developers.momo.vn/v3/docs/payment/onboarding/integration-process/

# -----------------------------------------------------------------------------
# Local development filesystem upload fallback
# -----------------------------------------------------------------------------

# OPTIONAL. Used only outside production when CLOUDINARY_ENABLED=false.
# These settings do not provide durable production upload storage.
UPLOAD_DIR=uploads
UPLOAD_PUBLIC_BASE_URL=/api/upload/files

# -----------------------------------------------------------------------------
# Local seed data
# -----------------------------------------------------------------------------

# OPTIONAL for application startup; used by seed scripts only.
SEED_PASSWORD=replace-for-local-seeding-only
