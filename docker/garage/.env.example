# Garage RPC secret: 32 random bytes encoded as hex.
# Example generation: openssl rand -hex 32
GARAGE_RPC_SECRET=

# Admin API token used by Garage and Garage WebUI.
# Example generation: openssl rand -base64 32
GARAGE_ADMIN_TOKEN=

# Garage WebUI expects username:<bcrypt-password-hash>.
GARAGE_UI_AUTH_USER_PASS=
