# Elite Drive frontend environment
# Copy this file to .env.local for local development.

# Server-side destination used by Next.js to proxy relative /api/* requests.
BACKEND_URL=http://localhost:8000

# Canonical frontend origin used for application metadata and API response headers.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# External payment providers are opt-in. Keep false for the zero-cost/local-first baseline.
NEXT_PUBLIC_MOMO_ENABLED=false
