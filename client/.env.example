# Elite Drive frontend environment
# Copy this file to .env.local for local development.

# REQUIRED IN PRODUCTION.
# Optional locally; development falls back to http://localhost:8000.
# Server-side destination used by Next.js to proxy relative /api/* requests.
BACKEND_URL=http://localhost:8000

# OPTIONAL override.
# Canonical frontend origin used for metadata. The app already falls back to the production URL.
# Built-in production default: https://elite-drive-iota.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OPTIONAL.
# UI feature flag only. Keep this aligned with backend MOMO_ENABLED.
NEXT_PUBLIC_MOMO_ENABLED=false
